<?xml version="1.0" encoding="utf-8"?>
<!-- The app icon. Android stacks two layers: a plain navy background and the
     binder picture on top, then cuts the result into whatever shape the phone
     uses (circle, rounded square, squircle...). The binder sits inside the
     middle "safe zone", so no shape ever cuts it off.
     The monochrome layer is used when "themed icons" are switched on. -->
<adaptive-icon xmlns:android="http://schemas.android.com/apk/res/android">
    <background android:drawable="@color/ic_launcher_background" />
    <foreground android:drawable="@mipmap/ic_launcher_foreground" />
    <monochrome android:drawable="@mipmap/ic_launcher_monochrome" />
</adaptive-icon>
