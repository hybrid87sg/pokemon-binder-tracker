rules_version = '2';

// Who may read and change what in the app's online database (Cloud Firestore).
// Paste this whole file into Firebase console > Firestore Database > Rules,
// then press Publish. (See "Shared binders" in the README.)
//
// binders/{binderId}            one binder: name, colour, size, owner, members
// binders/{binderId}/pages/{id} one page: which card is in each pocket
// binders/{binderId}/cover/picture  the owner's cover picture (small JPEG)
// invites/{code}                a share code: which binder, and Editor or Viewer
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    match /binders/{binderId} {
      // You can see a binder if you're one of its members.
      allow read: if signedIn() && request.auth.uid in resource.data.memberIds;

      // A new binder must be yours, with only you in it, as owner.
      allow create: if signedIn()
        && request.resource.data.ownerId == request.auth.uid
        && request.resource.data.memberIds == [request.auth.uid]
        && request.resource.data.roles[request.auth.uid] == 'owner';

      // The owner can change anything except who owns it.
      function ownerUpdate() {
        return signedIn()
          && resource.data.ownerId == request.auth.uid
          && request.resource.data.ownerId == resource.data.ownerId
          && request.auth.uid in request.resource.data.memberIds;
      }

      // Joining with a share code: you add only yourself, with the role the code gives.
      function joining() {
        let uid = request.auth.uid;
        let invite = get(/databases/$(database)/documents/invites/$(request.resource.data.joinCode)).data;
        return signedIn()
          && !(uid in resource.data.memberIds)
          && invite.binderId == binderId
          && invite.expiresAt > request.time
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['memberIds', 'roles', 'memberNames', 'joinCode'])
          && request.resource.data.memberIds.toSet() == resource.data.memberIds.toSet().union([uid].toSet())
          && request.resource.data.roles.diff(resource.data.roles).affectedKeys().hasOnly([uid])
          && request.resource.data.roles[uid] == invite.role
          && request.resource.data.memberNames.diff(resource.data.memberNames).affectedKeys().hasOnly([uid]);
      }

      // Leaving a binder someone shared with you: you remove only yourself.
      function leaving() {
        let uid = request.auth.uid;
        return signedIn()
          && uid in resource.data.memberIds
          && uid != resource.data.ownerId
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['memberIds', 'roles', 'memberNames'])
          && request.resource.data.memberIds.toSet() == resource.data.memberIds.toSet().difference([uid].toSet())
          && !(uid in request.resource.data.roles)
          && request.resource.data.roles.diff(resource.data.roles).affectedKeys().hasOnly([uid])
          && request.resource.data.memberNames.diff(resource.data.memberNames).affectedKeys().hasOnly([uid]);
      }

      // An Editor can change what's in the binder like the owner: its name,
      // colour, size and the expansions it collects. Who owns it, who is in
      // it, their roles and the share codes stay with the owner.
      function editorUpdate() {
        return signedIn()
          && resource.data.roles[request.auth.uid] == 'editor'
          && request.resource.data.diff(resource.data).affectedKeys()
               .hasOnly(['name', 'colorHex', 'columns', 'rows', 'followedSets', 'countSecretRares']);
      }

      allow update: if ownerUpdate() || editorUpdate() || joining() || leaving();
      allow delete: if signedIn() && resource.data.ownerId == request.auth.uid;

      match /pages/{pageId} {
        function binder() {
          return get(/databases/$(database)/documents/binders/$(binderId)).data;
        }
        // Used when a new binder and its pages are sent together.
        function binderAfter() {
          return getAfter(/databases/$(database)/documents/binders/$(binderId)).data;
        }
        function canEdit(b) {
          return b.roles[request.auth.uid] in ['owner', 'editor'];
        }

        allow read: if signedIn() && request.auth.uid in binder().memberIds;
        allow write: if signedIn() && (canEdit(binder()) || canEdit(binderAfter()));
      }

      // The binder's cover picture: everyone in the binder sees it, only the owner changes it.
      // (A small JPEG kept right in the database, so it works on the free plan.)
      match /cover/{docId} {
        function coverBinder() {
          return get(/databases/$(database)/documents/binders/$(binderId)).data;
        }
        allow read: if signedIn() && request.auth.uid in coverBinder().memberIds;
        allow create, update: if signedIn()
          && coverBinder().ownerId == request.auth.uid
          && request.resource.data.jpeg is bytes
          && request.resource.data.jpeg.size() < 700 * 1024;
        allow delete: if signedIn() && coverBinder().ownerId == request.auth.uid;
      }
    }

    match /invites/{code} {
      // Anyone signed in can look up a code they were given (but can't list codes).
      allow get: if signedIn();
      // Only a binder's owner can make codes for it.
      allow create: if signedIn()
        && request.resource.data.createdBy == request.auth.uid
        && get(/databases/$(database)/documents/binders/$(request.resource.data.binderId)).data.ownerId == request.auth.uid;
      allow delete: if signedIn() && resource.data.createdBy == request.auth.uid;
    }
  }
}
